---

<section id="contact" class="py-24 px-6 bg-section-bg dark:bg-section-bg text-white">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20">
    
    <div>
      <span class="reveal text-[#6352ff] text-base mb-4 block font-mono uppercase tracking-[0.3em]">// Contact</span>
      <h2 class="reveal text-3xl md:text-4xl font-black uppercase text-title leading-tight">
        Prêt à donner <br /> vie à votre <br /><span class="text-gradient-pink italic pr-2 mb-4">vision ?</span>
      </h2>
      <p class="reveal text-title/50 dark:text-white/50 text-sm mb-12 italic">Vous avez un projet ambitieux ? Un produit à lancer ?<br>Une refonte qui traîne depuis trop longtemps ?<br>Parlons-en, je réponds dans les 24h.</p>
      
      <div class="space-y-5 pb-8 mb-8 border-b border-title/8 dark:border-white/10">

        <!-- Email -->
        <div class="flex items-center gap-4">
          <div class="reveal w-10 h-10 shrink-0 rounded-xl bg-[#6352ff]/10 dark:bg-[#6352ff]/15 flex items-center justify-center text-[#6352ff]">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <p class="text-[10px] uppercase font-black tracking-widest text-title/40 dark:text-white/30 mb-0.5">Email</p>
            <a href="mailto:contact@mld-dev.com" class="reveal text-sm font-bold text-title dark:text-title hover:text-[#6352ff] dark:hover:text-[#9b8fff] transition-colors">
              contact@mld-dev.com
            </a>
          </div>
        </div>

        <!-- Localisation -->
        <div class="flex items-center gap-4">
          <div class="reveal w-10 h-10 shrink-0 rounded-xl bg-[#6352ff]/10 dark:bg-[#6352ff]/15 flex items-center justify-center text-[#6352ff]">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
          </div>
          <div>
            <p class="text-[10px] uppercase font-black tracking-widest text-title/40 dark:text-white/30 mb-0.5">Localisation</p>
            <p class="reveal text-sm font-bold text-title dark:text-title">
              Roanne, Loire (42300)
            </p>
            <p class="reveal text-[10px] font-bold text-[#6352ff]/60 dark:text-[#9b8fff]/60 uppercase tracking-wider">Intervention partout en France</p>
          </div>
        </div>

      </div>
    </div>

<div class="reveal bg-white dark:bg-card-bg mx-auto w-full max-w-100 md:max-w-none p-6 md:p-12 rounded-[40px] shadow-[0_20px_50px_rgba(99,82,255,0.08)] dark:shadow-[0_20px_50px_rgba(99,82,255,0.15)] border border-white dark:border-white/8">
  
<form id="form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
  <input type="hidden" name="access_key" value="ebae498f-43fc-44c7-8eba-7a8b00d55fe3">
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <label for="name" class="text-[10px] uppercase font-black tracking-[0.2em] text-title/70 dark:text-white/50 ml-2">Nom</label>
      <input type="text" id="name" name="name" autocomplete="name" required placeholder="Jean Dupont"
        class="w-full bg-[#f8f7ff] dark:bg-white/6 border border-transparent focus:border-[#6352ff]/30 focus:bg-white dark:focus:bg-white/10 rounded-2xl px-6 py-4 outline-none transition-all text-title dark:text-white placeholder:text-title/40 dark:placeholder:text-white/30" />
    </div>

    <div class="space-y-2">
      <label for="email" class="text-[10px] uppercase font-black tracking-[0.2em] text-title/70 dark:text-white/50 ml-2">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required placeholder="jean@mail.com"
        class="w-full bg-[#f8f7ff] dark:bg-white/6 border border-transparent focus:border-[#6352ff]/30 focus:bg-white dark:focus:bg-white/10 rounded-2xl px-6 py-4 outline-none transition-all text-title dark:text-white placeholder:text-title/40 dark:placeholder:text-white/30" />
    </div>
  </div>

  <div class="space-y-2">
    <label for="project_type" class="text-[10px] uppercase font-black tracking-[0.2em] text-title/70 dark:text-white/50 ml-2">Votre projet</label>
    <div class="relative">
      <select id="project_type" name="project_type" class="w-full bg-[#f8f7ff] dark:bg-white/6 border border-transparent focus:border-[#6352ff]/30 focus:bg-white dark:focus:bg-white/10 rounded-2xl px-6 py-4 outline-none transition-all text-title/70 dark:text-white/60 appearance-none cursor-pointer">
        <option value="Site Vitrine">Site Vitrine</option>
        <option value="Boutique E-commerce">Boutique E-commerce</option>
        <option value="Site Mono-page">Site Mono-page</option>
      </select>
      <div class="absolute right-6 top-1/2 -translate-y-1/2 pointer-events-none text-[#6352ff]">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80a8,8,0,0,1,11.32-11.32L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg>
      </div>
    </div>
  </div>

  <div class="space-y-2">
    <label for="message" class="text-[10px] uppercase font-black tracking-[0.2em] text-title/70 dark:text-white/50 ml-2">Message</label>
    <textarea id="message" rows="4" name="message" autocomplete="off" required placeholder="Parlez-moi de vos objectifs..."
      class="w-full bg-[#f8f7ff] dark:bg-white/6 border border-transparent focus:border-[#6352ff]/30 focus:bg-white dark:focus:bg-white/10 rounded-2xl px-6 py-4 outline-none transition-all text-title dark:text-white placeholder:text-title/40 dark:placeholder:text-white/30 resize-none"></textarea>
  </div>

  <button id="submit-btn" type="submit" class="w-full bg-[#6352ff] hover:bg-[#d363ff] text-white font-black uppercase tracking-widest py-6 rounded-2xl transition-all duration-500 shadow-xl shadow-[#6352ff]/25 flex items-center justify-center gap-3 group">
    <span id="btn-text">Envoyer la demande</span>
    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
  </button>

  <div id="result" class="text-center text-sm font-medium mt-4 min-h-5"></div>
</form>
</div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('form');
  const result = document.getElementById('result');
  const btn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    // État de chargement
    btn.disabled = true;
    btnText.innerText = "Envoi en cours...";
    result.innerHTML = "Veuillez patienter...";
    result.className = "text-center text-sm font-medium mt-4 min-h-5 text-title/50";

    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: json
    })
    .then(async (response) => {
      let res = await response.json();
      if (response.status == 200) {
        result.classList.replace('text-title/50', 'text-green-500');
        result.innerHTML = "✓ Message envoyé avec succès !";
        form.reset();
      } else {
        result.classList.replace('text-title/50', 'text-red-500');
        result.innerHTML = res.message || "Une erreur est survenue.";
      }
    })
    .catch(error => {
      result.classList.replace('text-title/50', 'text-red-500');
      result.innerHTML = "Une erreur réseau est survenue.";
    })
    .finally(() => {
      btn.disabled = false;
      btnText.innerText = "Envoyer la demande";
      setTimeout(() => {
        result.innerHTML = "";
      }, 5000);
    });
  });
</script>