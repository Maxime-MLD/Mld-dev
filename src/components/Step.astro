---
const steps = [
  {
    number: "01",
    phase: "Découverte",
    title: "Stratégie & Analyse",
    description: "On échange sur votre activité, vos objectifs et vos clients. Je construis l'architecture du site et le plan de contenu. C'est la fondation qui garantit un résultat aligné avec votre vision.",
    detail: "Réunion de lancement · Analyse concurrentielle · Plan du site · Brief créatif"
  },
  {
    number: "02",
    phase: "Création",
    title: "Design & Expérience",
    description: "Je conçois chaque écran sur mesure : typographie, couleurs, animations. Vous validez les maquettes avant que la moindre ligne de code soit écrite. Aucune surprise.",
    detail: "Maquettes desktop & mobile · Charte graphique · Validation client · Prototypage"
  },
  {
    number: "03",
    phase: "Développement",
    title: "Code & Performance",
    description: "Le site prend vie avec les technologies les plus performantes du marché. Chaque page est optimisée pour les moteurs de recherche et charge en moins d'une seconde.",
    detail: "Code sur-mesure · SEO technique · Sécurité HTTPS · Tests cross-navigateurs"
  },
  {
    number: "04",
    phase: "Mise en ligne",
    title: "Lancement & Suivi",
    description: "Je déploie votre site et vous forme à sa gestion. Vous êtes 100% autonome dès la livraison, et je reste disponible pour toute évolution future.",
    detail: "Déploiement · Formation personnalisée · Remise des accès · Support post-lancement"
  }
];
---

<section id="project" class="py-24 px-6 bg-main-bg overflow-hidden">
  <div class="max-w-7xl mx-auto mb-20">
    <h2 class="reveal text-3xl md:text-4xl font-black uppercase text-title leading-tight mb-4">
      Un parcours pensé<br /> pour le <span class="text-gradient-pink italic">succès.</span>
    </h2>
    <p class="reveal text-title/50 dark:text-white/35 text-sm max-w-md leading-relaxed">
      De la première discussion à la mise en ligne, chaque étape est pensée pour que votre projet se passe sans stress.
    </p>
  </div>

  <div class="max-w-7xl mx-auto">
    {steps.map((step, i) => (
      <div class="reveal grid grid-cols-1 lg:grid-cols-[120px_1px_1fr] gap-0 lg:gap-0 relative group" data-delay={i * 80}>

        <!-- Numéro -->
        <div class="lg:pr-10 flex lg:flex-col lg:items-end items-center gap-4 lg:gap-0 pb-4 lg:pb-0">
          <span class="text-6xl lg:text-8xl font-black italic text-title/8 dark:text-white/6 leading-none select-none group-hover:text-title/12 dark:group-hover:text-white/10 transition-colors duration-500">
            {step.number}
          </span>
          <span class="lg:hidden text-[9px] uppercase tracking-widest font-black text-[#6352ff]/50 dark:text-[#9b8fff]/50">{step.phase}</span>
        </div>

        <!-- Ligne verticale de connexion -->
        <div class="hidden lg:flex flex-col items-center">
          <div class="w-px flex-1 bg-title/8 dark:bg-white/8 group-hover:bg-[#6352ff]/30 transition-colors duration-500"></div>
          <div class="w-2.5 h-2.5 rounded-full border-2 border-[#6352ff]/30 dark:border-[#6352ff]/40 bg-main-bg dark:bg-main-bg group-hover:border-[#6352ff] group-hover:bg-[#6352ff]/10 transition-all duration-500 my-3 shrink-0"></div>
          {i < steps.length - 1 && (
            <div class="w-px flex-1 bg-title/8 dark:bg-white/8"></div>
          )}
          {i === steps.length - 1 && (
            <div class="flex-1"></div>
          )}
        </div>

        <!-- Contenu -->
        <div class="lg:pl-16 pb-16 lg:pb-20">
          <span class="hidden lg:block text-[9px] uppercase tracking-[0.25em] font-black text-[#6352ff]/50 dark:text-[#9b8fff]/50 mb-3">{step.phase}</span>

          <h3 class="text-2xl lg:text-3xl font-black uppercase text-title dark:text-title mb-4 group-hover:text-[#6352ff] transition-colors duration-300">
            {step.title}
          </h3>

          <p class="text-title/65 dark:text-white/50 text-base leading-relaxed max-w-xl mb-6">
            {step.description}
          </p>

          <!-- Détails en ligne -->
          <div class="flex flex-wrap gap-x-6 gap-y-1">
            {step.detail.split(' · ').map(item => (
              <span class="text-[11px] font-bold text-title/30 dark:text-white/25 uppercase tracking-wider">
                {item}
              </span>
            ))}
          </div>
        </div>

      </div>
    ))}
  </div>
</section>
<div class="w-full h-px bg-linear-to-r from-transparent via-[#d363ff]/40 to-transparent"></div>
