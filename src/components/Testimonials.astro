---
const testimonials = [
  {
    text: "Maxime a transformé ma présence en ligne en moins de 2 semaines. Le site est rapide, professionnel et mes clients le trouvent facilement sur Google. Le formulaire de contact m'apporte des demandes chaque semaine.",
    name: "Sophie Martin",
    role: "Gérante",
    company: "La Boulangerie du Terroir",
    initials: "SM",
    rating: 5
  },
  {
    text: "Je voulais un site simple, propre et efficace. Maxime a livré exactement ça, dans les délais et sans surprise. Le référencement local fonctionne : je reçois des demandes de devis depuis Google régulièrement.",
    name: "Thomas Durand",
    role: "Artisan Plombier",
    company: "Durand Plomberie & Chauffage",
    initials: "TD",
    rating: 5
  },
  {
    text: "Site vitrine livré en 10 jours, design premium, tout inclus. Maxime répond toujours sous 24h et explique chaque décision clairement. J'aurais payé le double dans une agence pour un résultat inférieur.",
    name: "Chloé Petit",
    role: "Consultante RH",
    company: "Indépendante",
    initials: "CP",
    rating: 5
  }
];
---

<section id="temoignages" class="py-24 px-6 bg-main-bg">
  <div class="max-w-7xl mx-auto mb-16">
    <span class="reveal text-[#6352ff] text-base mb-4 block font-mono uppercase tracking-[0.3em]">// Avis clients</span>
    <h2 class="reveal text-3xl md:text-4xl font-black uppercase text-title dark:text-title leading-tight mb-4">
      Ils m'ont fait<br><span class="text-gradient-pink italic">confiance.</span>
    </h2>
    <p class="reveal text-title/50 dark:text-white/35 text-sm max-w-md leading-relaxed">
      Des clients réels, des résultats concrets. Chaque projet est une collaboration avec un seul objectif : que votre site travaille pour vous.
    </p>
  </div>

  <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
    {testimonials.map((t, i) => (
      <div class="reveal-scale card-lift group bg-white dark:bg-card-bg rounded-[32px] p-8 border border-title/5 dark:border-white/8 shadow-sm flex flex-col justify-between" data-delay={i * 110}>

        <div>
          <!-- Étoiles -->
          <div class="flex gap-1 mb-6">
            {[...Array(t.rating)].map(() => (
              <svg class="w-4 h-4 text-[#f59e0b]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Citation -->
          <p class="text-title/70 dark:text-white/55 text-sm leading-relaxed mb-8 italic">
            "{t.text}"
          </p>
        </div>

        <!-- Auteur -->
        <div class="flex items-center gap-4 pt-6 border-t border-title/5 dark:border-white/8">
          <div class="w-11 h-11 rounded-full flex items-center justify-center text-white text-sm font-black shrink-0" style="background: linear-gradient(135deg, #6352ff, #d363ff);">
            {t.initials}
          </div>
          <div>
            <p class="font-black text-sm text-title dark:text-title">{t.name}</p>
            <p class="text-[11px] text-title/40 dark:text-white/30 font-bold uppercase tracking-wider">{t.role} - {t.company}</p>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>
<div class="w-full h-px bg-linear-to-r from-transparent via-[#d363ff]/40 to-transparent mb-0"></div>
